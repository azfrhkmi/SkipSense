# PostgreSQL connection string from Neon / Supabase (omit locally to use SQLite data/skipsense.db)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Generate a strong random secret (at least 32 chars), e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-48-char-secret-string-for-vercel

# Optional: automatically seed your Administrator account on startup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ReplaceWithStrongAdminPass1!

# Optional: protect one-time Admin Setup UI if ADMIN_EMAIL/ADMIN_PASSWORD aren't set above
ADMIN_SETUP_KEY=optional-one-time-setup-passphrase
